{
  "name": "tos-risk-analyzer",
  "version": "1.0.0",
  "description": "Kullanım koşulları, gizlilik politikası ve abonelik şartlarını analiz edip deterministik doğrulanmış risk raporu sunan Chrome uzantısı.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp src/manifest.json dist/manifest.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "npx tsx eval/run-eval.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --spec 'cypress/e2e/**/*.cy.ts'"
  },
  "keywords": [
    "chrome-extension",
    "terms-of-service",
    "ai-agent",
    "page-agent",
    "deterministic-validation",
    "prompt-injection"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "page-agent": "^0.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.7.5",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.15.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
