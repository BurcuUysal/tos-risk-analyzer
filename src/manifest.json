{
  "manifest_version": 3,
  "name": "ToS Risk Analizörü - Yapay Zekâ & Deterministik Doğrulama",
  "version": "1.0.0",
  "description": "Kullanım koşullarını, gizlilik politikalarını ve abonelik şartlarını analiz edip deterministik doğrulanmış risk raporu sunar.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "ToS Risk Analizörü"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
